<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Order Status"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvOrderIdDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order #12345"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp" />

    <!-- Status Options -->
    <RadioGroup
        android:id="@+id/rgStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Accepted -->
        <RadioButton
            android:id="@+id/rbAccepted"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅ Accepted - Going to pickup"
            android:textSize="15sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:button="@null"
            android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
            android:background="?attr/selectableItemBackground" />

        <!-- Picked Up -->
        <RadioButton
            android:id="@+id/rbPickedUp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📦 Picked Up - Package collected"
            android:textSize="15sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:button="@null"
            android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
            android:background="?attr/selectableItemBackground" />

        <!-- In Transit -->
        <RadioButton
            android:id="@+id/rbInTransit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🚴 In Transit - On the way"
            android:textSize="15sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:button="@null"
            android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
            android:background="?attr/selectableItemBackground" />

        <!-- Delivered -->
        <RadioButton
            android:id="@+id/rbDelivered"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅ Delivered - Order complete"
            android:textSize="15sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:button="@null"
            android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
            android:background="?attr/selectableItemBackground" />

    </RadioGroup>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_secondary"
            android:layout_marginEnd="8dp"
            style="@style/Anomaah.Button.Outlined" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Update Status"
            android:textColor="@color/white"
            android:background="@drawable/btn_success"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
